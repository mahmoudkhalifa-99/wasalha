rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Helpers ---
    function isSignedIn() { return request.auth != null; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'admin@ashmoun.com', 
          'mahmoudkhalifa.kh91@gmail.com', 
          'sadat.planning.officer@dakahlia.net',
          'admin@wasalah.com',
          'wasalah.app@gmail.com'
        ]
      );
    }

    function isAdmin() { 
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        getUserData().role in ['ADMIN', 'SUPER_ADMIN']
      )); 
    }

    function isOperator() { 
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        getUserData().role in ['OPERATOR', 'ADMIN', 'SUPER_ADMIN']
      )); 
    }

    function isStaff() { 
      return isAdmin() || isOperator();
    }

    function isDriver() { return hasRole('DRIVER'); }
    function isApproved() { return isStaff() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().status == 'APPROVED'); }
    
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isTerminalState(status) {
      return status in ['DELIVERED_RATED', 'CANCELLED'];
    }

    // --- Collection Routes ---

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && (resource.data.id == request.auth.uid || isStaff() || resource.data.role == 'DRIVER');
      allow create: if isValidId(userId) && (
        isStaff() ||
        (isOwner(userId) && (
          (incoming().role in ['ADMIN', 'OPERATOR'] && isBootstrappedAdmin()) ||
          incoming().role == 'CUSTOMER' ||
          incoming().role == 'DRIVER'
        ))
      );
      allow update: if isValidId(userId) && (
        isStaff() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'photoURL', 'location', 'wallet', 'plateNumber', 'vehicleType', 'status', 'rating', 'completedTrips', 'zoneId']))
      );
      allow delete: if isValidId(userId) && isStaff();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (
        isOwner(existing().customerId) || 
        isOwner(existing().driverId) ||
        (existing().assignedTo == request.auth.uid) ||
        existing().status == 'PENDING' ||
        existing().status == 'WAITING_FOR_OFFERS' ||
        isStaff()
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.driverId == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid ||
        resource.data.status == 'PENDING' ||
        resource.data.status == 'WAITING_FOR_OFFERS' ||
        isStaff()
      );
      allow create: if isValidId(orderId) && isSignedIn() && (isOwner(incoming().customerId) || isStaff());
      allow update: if isValidId(orderId) && isSignedIn() && (
        isStaff() ||
        isOwner(existing().customerId) ||
        isOwner(existing().driverId) ||
        (existing().assignedTo == request.auth.uid) ||
        (isOwner(incoming().driverId) && (existing().status == 'PENDING' || existing().status == 'WAITING_FOR_OFFERS'))
      );
      allow delete: if isValidId(orderId) && isStaff();
    }

    match /offers/{offerId} {
      allow get: if isValidId(offerId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(offerId) && isSignedIn();
      allow update, delete: if isValidId(offerId) && (isOwner(existing().driverId) || isStaff());
    }

    match /messages/{msgId} {
      allow get: if isValidId(msgId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(msgId) && isSignedIn();
      allow update, delete: if isValidId(msgId) && isStaff();
    }

    match /notifications/{notifId} {
      allow get: if isValidId(notifId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isValidId(notifId) && (isStaff() || isSignedIn());
    }

    match /restaurants/{restId} {
      allow get, list: if true;
      allow write: if isValidId(restId) && isStaff();
    }

    match /ads/{adId} {
      allow get, list: if true;
      allow update: if isValidId(adId);
      allow create, delete: if isValidId(adId) && isStaff();
    }

    match /geo_config/{geoId} {
      allow get, list: if true;
      allow write: if isValidId(geoId) && isStaff();
    }

    match /feedback/{feedId} {
      allow get, list: if isStaff();
      allow create: if isValidId(feedId) && isSignedIn();
      allow update, delete: if isValidId(feedId) && isStaff();
    }

    match /transactions/{transId} {
      allow get, list: if isSignedIn() && (isOwner(resource.data.userId) || isStaff());
      allow write: if isValidId(transId) && isStaff();
    }

    match /payment_requests/{requestId} {
      allow get, list: if isSignedIn() && (isOwner(resource.data.userId) || isStaff());
      allow create: if isValidId(requestId) && isSignedIn();
      allow update, delete: if isValidId(requestId) && isStaff();
    }
    
    match /couriers/{courierId} {
      allow get, list: if isSignedIn();
      allow write: if isValidId(courierId) && (isStaff() || isSignedIn());
    }

    match /test/{docId} {
      allow read, write: if true;
    }

  }
}
