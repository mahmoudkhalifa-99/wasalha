{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "OPERATOR", "DRIVER", "CUSTOMER"] },
        "status": { "type": "string", "enum": ["PENDING_APPROVAL", "APPROVED", "SUSPENDED"] },
        "photoURL": { "type": "string" },
        "wallet": { "type": "object" },
        "location": { "type": "object" }
      },
      "required": ["id", "email", "phone", "name", "role", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order/trip",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerPhone": { "type": "string" },
        "driverId": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "PENDING", "ASSIGNED", "PICKED", "IN_DELIVERY", "DELIVERED", "CANCELLED", "WAITING_FOR_OFFERS", "ACCEPTED", "PICKED_UP", "DELIVERED_RATED"] },
        "price": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["customerId", "customerPhone", "status", "price", "createdAt", "updatedAt"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Driver's offer for an order",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "driverId": { "type": "string" },
        "price": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["orderId", "driverId", "price", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message for an order",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["orderId", "senderId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/orders/{orderId}": { "schema": "Order", "description": "Trip/Order records" },
    "/offers/{offerId}": { "schema": "Offer", "description": "Driver offers" },
    "/messages/{msgId}": { "schema": "Message", "description": "Chat messages" },
    "/notifications/{notifId}": { "schema": "object", "description": "User notifications" },
    "/restaurants/{restId}": { "schema": "object", "description": "Restaurant data" },
    "/ads/{adId}": { "schema": "object", "description": "Ads and banners" },
    "/geo_config/{geoId}": { "schema": "object", "description": "Geographic centroids and villages" },
    "/feedback/{feedId}": { "schema": "object", "description": "User feedback" },
    "/transactions/{transId}": { "schema": "object", "description": "Financial transactions" },
    "/payment_requests/{requestId}": { "schema": "object", "description": "Driver payout requests" }
  }
}
